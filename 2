];

const STORAGE_KEY = "china_2026_editable_trip";
let currentData = [];

// INICIALIZACIÓN
function init() {
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) {
    try { currentData = JSON.parse(saved); } catch(e) { currentData = initialRouteData; }
  } else {
    currentData = initialRouteData;
  }
  renderTimeline();
}

function saveData() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(currentData));
}

// PINTAR LA LÍNEA TEMPORAL EN PANTALLA
function renderTimeline() {
  const container = document.getElementById("daysContainer");
  container.innerHTML = "";

  currentData.forEach((day, index) => {
    const bucket = document.createElement("div");
    bucket.className = "day-bucket";
    bucket.id = `bucket-${day.id}`;

    // Lista de actividades formateada
    let actHtml = "";
    if (day.activities && day.activities.length > 0) {
      day.activities.forEach((act, actIdx) => {
        actHtml += `
          <li class="act-item cat-${act.cat || 'culture'}">
            <span class="act-icon">${getIconForCat(act.cat)}</span>
            <div class="act-body">
              <div class="act-title">${act.title}</div>
              <div class="act-sub">${act.sub || ''}</div>
            </div>
            <button class="act-del" onclick="deleteActivity('${day.id}', ${actIdx}, event)">✕</button>
          </li>`;
      });
    } else {
      actHtml = `<span style="font-size:12px; color:var(--muted); font-style:italic;">Sense activitats planificades. Afegeix-ne una a baix!</span>`;
    }

    bucket.innerHTML = `
      <div class="day-trigger" onclick="toggleBucket('${day.id}')">
        <div class="day-date-box">
          <span class="day-num">${day.date}</span>
          <span class="day-month">${day.month}</span>
        </div>
        <div class="day-title-box">
          <div class="day-main-city">${day.city} <span class="zh">${day.zh || ''}</span></div>
        </div>
        <div class="day-chevron"><i class="fa-solid fa-chevron-down"></i></div>
      </div>
      <div class="day-drop">
        <div class="day-drop-content">
          
          <!-- LOGÍSTICA: PRÓXIMO DESTINO & TRANSPORTE -->
          <div class="logistics-grid">
            <div class="log-box">
              <span class="log-label"><i class="fa-solid fa-location-arrow"></i> Pròxim Destí</span>
              <input type="text" class="log-val" value="${day.next_dest || ''}" placeholder="Ex: Shaxi..." onchange="updateField('${day.id}', 'next_dest', this.value)">
            </div>
            <div class="log-box">
              <span class="log-label"><i class="fa-solid fa-train-subway"></i> Com anirem</span>
              <input type="text" class="log-val" value="${day.transport || ''}" placeholder="Ex: Tren d'alta velocitat..." onchange="updateField('${day.id}', 'transport', this.value)">
            </div>
          </div>

          <!-- ALLOTJAMENT INTEGRAT -->
          <div class="accom-box">
            <div class="accom-title-label"><i class="fa-solid fa-hotel"></i> Allotjament del dia</div>
            <div class="accom-row">
              <span class="accom-field-label">Nom</span>
              <input type="text" class="log-val" style="font-size:12px;" value="${day.hotel_name || ''}" placeholder="Hotel / Hostel nom..." onchange="updateField('${day.id}', 'hotel_name', this.value)">
            </div>
            <div class="accom-row">
              <span class="accom-field-label">Adreça</span>
              <input type="text" class="log-val" style="font-size:12px; color:var(--muted);" value="${day.hotel_addr || ''}" placeholder="Link o carrer xinès..." onchange="updateField('${day.id}', 'hotel_addr', this.value)">
            </div>
            <div class="accom-row">
              <span class="accom-field-label">Notes</span>
              <input type="text" class="log-val" style="font-size:11px; color:var(--accent);" value="${day.hotel_notes || ''}" placeholder="Codi de porta, metro proper, check-in..." onchange="updateField('${day.id}', 'hotel_notes', this.value)">
            </div>
          </div>

          <!-- SECCIÓN ACTIVIDADES MÚLTIPLES -->
          <div class="activities-wrapper">
            <span class="log-label"><i class="fa-solid fa-star"></i> Activitats planificades</span>
            <ul class="act-list">${actHtml}</ul>
            
            <!-- FORMULARIO INLINE PARA AÑADIR NUEVAS -->
            <div class="add-act-form" onclick="event.stopPropagation();">
              <div class="form-row-inline">
                <input type="text" id="add-title-${day.id}" class="form-input" placeholder="Títol de l'activitat...">
                <select id="add-cat-${day.id}" class="form-select">
                  <option value="culture">🏛️ Cultura</option>
                  <option value="food">🍜 Menjar</option>
                  <option value="nature">🌳 Natura</option>
                  <option value="party">🎵 Festa</option>
                  <option value="art">🎨 Art/Moda</option>
                </select>
              </div>
              <input type="text" id="add-sub-${day.id}" class="form-input" placeholder="Detalls extra, preu o localització (opcional)...">
              <button class="form-btn" onclick="addActivity('${day.id}')">Afegir a la llista</button>
            </div>
          </div>

        </div>
      </div>
    `;
    container.appendChild(bucket);
  });
}

// ICONOS PARA CATEGORÍAS
function getIconForCat(cat) {
  switch(cat) {
    case 'food': return '🍜';
    case 'nature': return '🌳';
    case 'party': return '🎵';
    case 'art': return '🎨';
    default: return '🏛️';
  }
}

// INTERACTVIDAD DE DESPLEGAR
function toggleBucket(id) {
  const el = document.getElementById(`bucket-${id}`);
  el.classList.toggle("open");
}

// ACTUALIZACIÓN DE CAMPOS DE TEXTO DIRECTOS
function updateField(dayId, field, value) {
  const day = currentData.find(d => d.id === dayId);
  if (day) {
    day[field] = value;
    saveData();
  }
}

// AÑADIR NUEVA ACTIVIDAD DINÁMICA
function addActivity(dayId) {
  const titleEl = document.getElementById(`add-title-${dayId}`);
  const subEl = document.getElementById(`add-sub-${dayId}`);
  const catEl = document.getElementById(`add-cat-${dayId}`);

  if (!titleEl.value.trim()) return alert("Escriu un títol per a l'activitat!");

  const day = currentData.find(d => d.id === dayId);
  if (day) {
    if (!day.activities) day.activities = [];
    day.activities.push({
      title: titleEl.value.trim(),
      sub: subEl.value.trim(),
      cat: catEl.value
    });
    saveData();
    renderTimeline();
    // Re-abrir el desplegable para ver el cambio instantáneo
    document.getElementById(`bucket-${dayId}`).classList.add("open");
  }
}

// ELIMINAR ACTIVIDADES
function deleteActivity(dayId, index, event) {
  event.stopPropagation(); // Evita que se cierre el acordeón al pulsar borrar
  const day = currentData.find(d => d.id === dayId);
  if (day && day.activities) {
    day.activities.splice(index, 1);
    saveData();
    renderTimeline();
    document.getElementById(`bucket-${dayId}`).classList.add("open");
  }
}

// ─── CONTROL DE INTERFÍCIE SINCRO (IMPORT / EXPORT) ───
let modalMode = 'export';

function openModal(mode) {
  modalMode = mode;
  const modal = document.getElementById("syncModal");
  const title = document.getElementById("modalTitle");
  const desc = document.getElementById("modalDesc");
  const area = document.getElementById("modalData");
  const actBtn = document.getElementById("modalActionBtn");

  modal.style.display = "flex";

  if (mode === 'export') {
    title.textContent = "Exportar dades del viatge";
    desc.textContent = "Copia aquest codi encriptat complet i passa'l als teus amics per WhatsApp. Inclou tota la llista actualitzada de l'equip.";
    area.value = btoa(unescape(encodeURIComponent(JSON.stringify(currentData)))); // Base64 Safe string
    area.readOnly = true;
    actBtn.textContent = "Copiar Codi";
  } else {
    title.textContent = "Importar canvis d'un amic";
    desc.textContent = "Enganxa aquí el codi que t'ha passat el teu company per WhatsApp per sincronitzar tots els hotels i activitats noves al teu mòbil.";
    area.value = "";
    area.readOnly = false;
    actBtn.textContent = "Sincronitzar ara";
  }
}

function closeModal() {
  document.getElementById("syncModal").style.display = "none";
}

function executeModalAction() {
  const area = document.getElementById("modalData");
  if (modalMode === 'export') {
    area.select();
    document.execCommand("copy");
    const actBtn = document.getElementById("modalActionBtn");
    actBtn.textContent = "✓ Copiat!";
    setTimeout(() => closeModal(), 1000);
  } else {
    const rawVal = area.value.trim();
    if (!rawVal) return alert("Si us plau, enganxa un codi vàlid.");
    try {
      const decodedData = JSON.parse(decodeURIComponent(escape(atob(rawVal))));
      if (Array.isArray(decodedData) && decodedData.length > 0) {
        currentData = decodedData;
        saveData();
        renderTimeline();
        alert("Sincronització completada amb èxit! La teva guia s'ha actualitzat.");
        closeModal();
      } else {
        alert("El codi no té el format correcte de la ruta.");
      }
    } catch(e) {
      alert("Error al llegir el codi. Assegura't de copiar el text sencer enviat per WhatsApp.");
    }
  }
}

window.onload = init;
</script>
