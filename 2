<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>China 2026 — Trip Guide</title>
<link href="https://fonts.googleapis.com/css2?family=Anybody:ital,wght@0,400;0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
:root {
  --black: #0a0a0a;
  --white: #f5f2ec;
  --red: #e8350f;
  --accent: #c8f060;
  --muted: #8a8780;
  --card-bg: #141412;
  --border: rgba(245,242,236,0.1);
  --edit-border: rgba(200,240,96,0.4);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { background: var(--black); color: var(--white); font-family: 'DM Sans', sans-serif; font-weight: 300; overflow-x: hidden; padding-bottom: 80px; }

/* REPOSITORIO GLOBAL SYNC PANEL */
.sync-banner {
  background: var(--card-bg); border-bottom: 1px solid var(--border);
  padding: 1rem 2rem; display: flex; flex-wrap: wrap; gap: 10px;
  align-items: center; justify-content: space-between; position: relative; z-index: 101;
}
.sync-title { font-size: 12px; font-weight: bold; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
.sync-btns { display: flex; gap: 8px; }
.sync-btn { background: rgba(245,242,236,0.05); border: 1px solid var(--border); color: var(--white); padding: 6px 12px; border-radius: 6px; font-size: 11px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
.sync-btn:hover { border-color: var(--accent); color: var(--accent); }
.sync-btn.primary { background: var(--accent); color: var(--black); border: none; font-weight: bold; }

/* MODAL DE IMPORTACIÓN/EXPORTACIÓN */
.sync-modal {
  position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);
  z-index: 9999; display: none; align-items: center; justify-content: center; padding: 20px;
}
.modal-content { background: var(--card-bg); border: 1px solid var(--border); width: 100%; max-width: 500px; border-radius: 12px; padding: 20px; }
.modal-content h3 { font-family: 'Anybody', sans-serif; font-size: 18px; margin-bottom: 10px; text-transform: uppercase; color: var(--accent); }
.modal-content p { font-size: 12px; color: var(--muted); margin-bottom: 12px; }
.modal-textarea { width: 100%; height: 180px; background: #000; border: 1px solid var(--border); color: var(--accent); font-family: monospace; font-size: 11px; padding: 10px; border-radius: 6px; resize: none; margin-bottom: 15px; }
.modal-textarea:focus { outline: none; border-color: var(--accent); }

/* HEADER */
header { position: relative; padding: 4rem 2rem 2rem 2rem; overflow: hidden; background: radial-gradient(ellipse 80% 60% at 70% 40%, rgba(232,53,15,0.15) 0%, transparent 60%), var(--black); border-bottom: 1px solid var(--border); }
.trip-tag { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent); padding: 6px 14px; border-radius: 999px; margin-bottom: 1.5rem; }
h1 { font-family: 'Anybody', sans-serif; font-size: clamp(3rem, 10vw, 6rem); font-weight: 900; line-height: 0.88; letter-spacing: -0.03em; text-transform: uppercase; margin-bottom: 1.5rem; }
h1 span.outline { -webkit-text-stroke: 1.5px var(--white); color: transparent; }
h1 span.red { color: var(--red); }
.header-meta { display: flex; gap: 10px; flex-wrap: wrap; }
.meta-pill { background: rgba(245,242,236,0.05); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; font-size: 12px; color: var(--muted); }
.meta-pill strong { color: var(--white); }

/* SECTION & ITINERARY */
section { padding: 3rem 2rem; }
.section-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--red); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px; }
.section-label::after { content: ''; flex: 1; max-width: 60px; height: 1px; background: var(--red); }
h2 { font-family: 'Anybody', sans-serif; font-size: 2rem; font-weight: 700; text-transform: uppercase; margin-bottom: 2rem; }

/* ACORDEÓN MEJORADO (FILA DIARIA) */
.day-bucket { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; margin-bottom: 12px; overflow: hidden; transition: border-color 0.2s; }
.day-bucket:hover { border-color: rgba(245,242,236,0.2); }
.day-trigger { padding: 1.5rem; display: grid; grid-template-columns: 60px 1fr 30px; align-items: center; cursor: pointer; background: transparent; }
.day-date-box { display: flex; flex-direction: column; justify-content: center; border-right: 1px solid var(--border); }
.day-num { font-family: 'Anybody', sans-serif; font-size: 1.8rem; font-weight: 900; line-height: 1; color: var(--red); }
.day-month { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
.day-title-box { padding-left: 1.2rem; }
.day-main-city { font-family: 'Anybody', sans-serif; font-size: 1.2rem; font-weight: 700; text-transform: uppercase; letter-spacing: -0.01em; display: flex; align-items: center; gap: 8px; }
.day-main-city span.zh { font-size: 13px; color: var(--red); font-weight: 300; }
.day-chevron { text-align: right; color: var(--muted); transition: transform 0.3s; }

/* CONTENIDO DESPLEGABLE */
.day-drop { max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; background: rgba(0,0,0,0.2); }
.day-drop-content { padding: 1.5rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 1.5rem; }

.open .day-drop { max-height: 2000px; transition: max-height 0.5s ease-in; }
.open .day-chevron { transform: rotate(180deg); color: var(--accent); }

/* CUADROS LOGÍSTICA */
.logistics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; border-bottom: 1px dashed var(--border); padding-bottom: 1.2rem; }
.log-box { display: flex; flex-direction: column; gap: 4px; }
.log-label { font-size: 10px; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em; display: flex; align-items: center; gap: 5px; }
.log-label i { color: var(--accent); }
.log-val { font-size: 13px; color: var(--white); background: transparent; border: none; border-bottom: 1px dashed transparent; padding: 2px 0; width: 100%; }
.log-val:focus { outline: none; border-bottom-color: var(--accent); background: rgba(255,255,255,0.02); }

/* LISTA ACTIVIDADES */
.activities-wrapper { display: flex; flex-direction: column; gap: 10px; }
.act-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.act-item { display: grid; grid-template-columns: 24px 1fr 24px; gap: 8px; align-items: start; background: rgba(255,255,255,0.02); padding: 10px; border-radius: 6px; border-left: 3px solid var(--muted); }
.act-icon { font-size: 13px; text-align: center; margin-top: 1px; }
.act-body { font-size: 13px; line-height: 1.4; }
.act-title { font-weight: 500; color: var(--white); }
.act-sub { color: var(--muted); font-size: 12px; margin-top: 2px; }
.act-del { background: transparent; border: none; color: rgba(232,53,15,0.4); cursor: pointer; font-size: 11px; text-align: right; padding-top: 2px; }
.act-del:hover { color: var(--red); }

/* COLORES CATEGORÍAS */
.cat-nature { border-left-color: #7ec44a !important; }
.cat-food { border-left-color: #f0a040 !important; }
.cat-culture { border-left-color: #60b8f0 !important; }
.cat-party { border-left-color: #e8604a !important; }
.cat-art { border-left-color: #a890f0 !important; }

/* FORMULARIO NUEVA ACTIVIDAD */
.add-act-form { background: rgba(245,242,236,0.03); border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin-top: 8px; display: flex; flex-direction: column; gap: 8px; }
.form-row-inline { display: grid; grid-template-columns: 1fr 100px; gap: 8px; }
.form-input { background: #000; border: 1px solid var(--border); color: var(--white); padding: 6px 10px; font-size: 12px; border-radius: 4px; }
.form-input:focus { outline: none; border-color: var(--accent); }
.form-select { background: #000; border: 1px solid var(--border); color: var(--muted); padding: 6px 8px; font-size: 11px; border-radius: 4px; }
.form-btn { background: var(--accent); color: var(--black); font-weight: bold; border: none; padding: 6px 12px; font-size: 11px; border-radius: 4px; cursor: pointer; text-transform: uppercase; }
.form-btn:hover { opacity: 0.9; }

/* SECCIÓN ALBERGUES/HOTELES INTEGRADA */
.accom-box { background: rgba(200,240,96,0.02); border: 1px solid rgba(200,240,96,0.15); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
.accom-title-label { font-size: 11px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; display: flex; align-items: center; gap: 6px; }
.accom-row { display: grid; grid-template-columns: 70px 1fr; gap: 8px; align-items: center; }
.accom-field-label { font-size: 11px; color: var(--muted); }

/* TIPS CARD SECTOR */
.tips-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
.tip-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
.tip-emoji { font-size: 1.5rem; margin-bottom: 0.5rem; display: block; }
.tip-title { font-size: 13px; font-weight: 500; margin-bottom: 4px; color: var(--white); }
.tip-body { font-size: 12px; color: var(--muted); line-height: 1.5; }

/* APPS GRID */
.app-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; margin-top: 1rem; }
.app-item { background: var(--card-bg); border: 1px solid var(--border); padding: 12px; border-radius: 8px; display: flex; align-items: center; gap: 10px; }
.app-item i { font-size: 1.5rem; }

footer { padding: 3rem 2rem; border-top: 1px solid var(--border); text-align: center; }
.footer-title { font-family: 'Anybody', sans-serif; font-size: 1.2rem; font-weight: 900; text-transform: uppercase; }
.footer-sub { font-size: 11px; color: var(--muted); margin-top: 4px; }

@media (max-width: 600px) {
  section, .sync-banner { padding-left: 1.2rem; padding-right: 1.2rem; }
  .day-trigger { grid-template-columns: 50px 1fr 20px; padding: 1rem; }
  .day-title-box { padding-left: 0.8rem; }
  .day-main-city { font-size: 1.1rem; }
  .logistics-grid { grid-template-columns: 1fr; }
}
</style>
</head>
